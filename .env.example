# Riptide executor configuration
# Copy this file to .env and fill in the three values.

# The token Riptide sent you (a long random string)
RIPTIDE_API_TOKEN=paste-token-here

# Where the central server is. Ask Riptide if unsure.
RIPTIDE_WS_URL=wss://api.riptideintel.com

# Which market to trade: futures or spot
MARKET=futures

# DRY_RUN=true means it logs trades but sends NOTHING. Leave it true
# until you've watched it run for a few days.
DRY_RUN=true

# KuCoin API keys — only needed when DRY_RUN=false. Create at
# kucoin.com under Account Security > API Management, permissions:
# General + Trade ONLY. Never enable withdrawals on a trading key.
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
