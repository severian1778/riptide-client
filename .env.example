# Riptide executor configuration
# Copy this file to .env and fill in the values.
# NEVER commit this file. NEVER paste it into a chat.

# ── The server connection ──────────────────────────────────────

# The token Riptide sent you (a long random string, shown ONCE when
# created). Without it the executor stays asleep and does nothing.
RIPTIDE_API_TOKEN=paste-token-here

# Where the central server is. Ask Riptide if unsure.
RIPTIDE_WS_URL=wss://api.riptideintel.com

# Which market to trade: futures or spot.
# (The executor listens for spot anchors too — spot signals are
# traded on futures. This sets the primary stream.)
MARKET=futures

# ── The big red switch ─────────────────────────────────────────

# DRY_RUN=true means it logs trades but sends NOTHING. Leave it true
# until you've watched it run for a few days.
DRY_RUN=true

# ── Which exchange ─────────────────────────────────────────────

# "hyperliquid" (default) or "kucoin"
VENUE=hyperliquid

# ── Money settings ─────────────────────────────────────────────

# The capital base used for sizing math. NOT read from the exchange —
# this is the number you declare. Start small on mainnet.
BANKROLL_USD=10000

# Maximum bet fraction. Kelly's suggestion can never exceed this.
# 0.2 = never risk more than 20% of bankroll on one trade.
KELLY_CAP=0.2

# Hard ceiling on position size in BTC, no matter what the math says.
MAX_POSITION_BTC=0.5

# ── Hyperliquid (only needed when DRY_RUN=false) ───────────────

# true  = testnet (fake money). START HERE.
# false = mainnet (real money).
HYPERLIQUID_TESTNET=true

# The AGENT wallet's PRIVATE key (0x...). Trade-only — it cannot
# withdraw. Create it on app.hyperliquid.xyz under the API tab
# (Approve Agent), using your Rabby wallet to sign.
HYPERLIQUID_AGENT_KEY=0x-your-agent-private-key

# Your MASTER wallet's ADDRESS (0x...). Public info — safe to share.
# This is the account the robot trades on behalf of.
HYPERLIQUID_MASTER_ADDRESS=0x-your-master-wallet-address

# Leverage. 10x isolated is the default.
HYPERLIQUID_LEVERAGE=10

# ── KuCoin (only if VENUE=kucoin) ──────────────────────────────

# Create at kucoin.com under Account Security > API Management,
# permissions: General + Trade ONLY. Never enable withdrawals on
# a trading key.
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
KUCOIN_LEVERAGE=5

# ── Storage (usually leave alone) ──────────────────────────────

# Where the trade journal is written. Survives restarts.
LEDGER_DIR=priv/ledger

